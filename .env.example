# Diyanet Kur'an API ayarları
# Bu dosyayı kopyalayın: cp .env.example .env.local
# .env.local dosyası git'e eklenmez, token'ınızı yalnızca orada saklayın.

# API temel adresi (sonunda / olmadan).
# Güncel adres için: https://acikkaynakkuran-dev.diyanet.gov.tr
DIB_KURAN_API_BASE_URL=

# API erişim token'ı.
# Başvuru için: https://acikkaynakkuran-dev.diyanet.gov.tr
DIB_KURAN_API_TOKEN=
